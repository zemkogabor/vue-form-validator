{
  "name": "@zemkogabor/vue-form-validator",
  "version": "1.0.0",
  "description": "A lightweight Vue.js library that implements the JavaScript Constraint Validation API, offering advanced form validation with custom error messages and internationalization support.",
  "module": "./dist/vue-form-validator.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/vue-form-validator.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "serve": "vite preview",
    "eslint": "eslint '{**/*,*}.{js,ts,jsx,tsx,vue}' --cache",
    "eslint:fix": "eslint '{**/*,*}.{js,ts,jsx,tsx,vue}' --fix"
  },
  "keywords": [
    "vue.js",
    "form-validaton",
    "constraint-validation-api",
    "validator",
    "custom-validator",
    "i18n",
    "lightweight"
  ],
  "author": "Gabor Zemko <gaborzemko@gmail.com>",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.15.0",
    "@tsconfig/node20": "^20.1.8",
    "@types/node": "^25.0.10",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-vue": "^10.7.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.27",
    "vue-tsc": "^3.2.3"
  }
}
